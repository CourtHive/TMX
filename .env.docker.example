# Public port for the combined TMX + CFS origin.
TMX_PORT=8080
APP_BASE_URL=http://localhost:8080
# Internal CFS listen/upstream port (shared by CFS, nginx, and health checks).
APP_PORT=8383

# Change these before exposing the stack beyond a trusted development machine.
JWT_SECRET=replace-with-a-long-random-value
PG_USER=courthive
PG_PASSWORD=replace-with-a-random-password
PG_DATABASE=courthive

# Optional initial super-admin. Created after database migrations on the first
# start; an existing account and its password are left unchanged on restarts.
TMX_ADMIN_EMAIL=admin@example.com
TMX_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# TMX_ADMIN_PROVIDER_ID=

# Optional deployment controls.
JWT_VALIDITY=2h
CFS_CORS_ORIGINS=*
CFS_REF=525571e5f8110376d6c8534c37cc3d975a2f0f15

# Optional crowd-scoring relay. The Compose stack does not run one by default.
# Set a URL to enable it, or leave this sentinel in place to prevent reconnect spam.
VITE_SCORE_RELAY_URL=disabled

# Public port for the combined TMX + CFS origin.
TMX_PORT=8080
APP_BASE_URL=http://localhost:8080

# Change these before exposing the stack beyond a trusted development machine.
JWT_SECRET=replace-with-a-long-random-value
PG_USER=courthive
PG_PASSWORD=replace-with-a-random-password
PG_DATABASE=courthive

# Optional deployment controls.
JWT_VALIDITY=2h
CFS_CORS_ORIGINS=*
CFS_REF=525571e5f8110376d6c8534c37cc3d975a2f0f15

# Optional crowd-scoring relay. The Compose stack does not run one by default.
# Set a URL to enable it, or leave this sentinel in place to prevent reconnect spam.
VITE_SCORE_RELAY_URL=disabled
